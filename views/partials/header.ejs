<a class="skip-link" href="#main">Skip to content</a>

<div class="topbar">
  <div class="topbar-inner">
    <span><%= trust.legalForm %> · <%= trust.location %></span>
    <span class="topbar-links">
      <a href="<%= langSwitchUrl %>" class="lang-switch" lang="<%= lang === 'hi' ? 'en' : 'hi' %>"><%= lang === 'hi' ? 'English' : 'हिन्दी' %></a>
      <a href="tel:+91<%= trust.phone %>" class="topbar-phone"><%= trust.phoneDisplay %></a>
      <a href="mailto:<%= trust.email %>" class="topbar-email"><%= trust.email %></a>
      <% if (currentUser) { %>
        <a href="/account">My Account</a>
        <form action="/logout" method="POST" class="inline-form">
          <button type="submit" class="topbar-btn">Logout</button>
        </form>
      <% } else { %>
        <a href="/login">Login</a>
        <a href="/register">Register</a>
      <% } %>
      <% if (isAdmin) { %><a href="/admin/dashboard">Admin</a><% } %>
    </span>
  </div>
</div>

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="<%= trust.name %> home">
      <img src="/images/logo-mark.png" alt="" width="54" height="54" class="brand-mark">
      <span class="brand-text">
        <strong>JBC</strong>
        <small>SEVA TRUST</small>
      </span>
    </a>

    <button
      type="button"
      class="nav-toggle"
      aria-controls="siteNav"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <span></span><span></span><span></span>
    </button>

    <nav id="siteNav" class="site-nav" aria-label="Main">
      <% const navLink = (href, label, extra) => { %>
        <a href="<%= href %>" class="<%= (currentPath === href || (extra && currentPath.startsWith(extra))) ? 'active' : '' %>" <% if (currentPath === href) { %>aria-current="page"<% } %>><%= label %></a>
      <% } %>

      <% navLink('/', 'Home') %>
      <% navLink('/#work', 'Our Work', '/work/') %>
      <% navLink('/events', 'Events') %>
      <% navLink('/updates', 'Updates') %>
      <% navLink('/volunteer', 'Volunteer') %>
      <% navLink('/medical', 'Medical Help') %>
      <% navLink('/contact', 'Contact') %>

      <span class="nav-account">
        <% if (currentUser) { %>
          <% navLink('/account', 'My Account') %>
          <form action="/logout" method="POST" class="inline-form">
            <button type="submit" class="nav-link-btn">Logout</button>
          </form>
        <% } else { %>
          <% navLink('/login', 'Login') %>
          <% navLink('/register', 'Register') %>
        <% } %>
        <% if (isAdmin) { %>
          <a href="/admin/dashboard">Admin</a>
        <% } %>
      </span>

      <a href="<%= langSwitchUrl %>" class="nav-lang" lang="<%= lang === 'hi' ? 'en' : 'hi' %>"><%= lang === 'hi' ? 'English' : 'हिन्दी' %></a>
      <a href="/donate" class="btn nav-donate">Donate</a>
    </nav>
  </div>
</header>
