<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= locals.title ? `${title} - ${trust.name}` : `${trust.name} | ${trust.tagline}` %></title>
<meta name="description" content="<%= locals.description || `${trust.name}, ${trust.location}: elder care (Anand Dham), marriage support (Kanyadaan), child education and nutrition, tree plantation and a community temple.` %>" />
<meta name="theme-color" content="#14365d" />
<meta property="og:title" content="<%= trust.name %>" />
<meta property="og:description" content="<%= trust.tagline %>" />
<meta property="og:image" content="/images/logo-full.png" />
<link rel="icon" type="image/png" href="/images/logo-mark.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700&family=Noto+Sans+Devanagari:wght@400;600&family=Noto+Serif:wght@600;700&family=Noto+Serif+Devanagari:wght@600;700&display=swap" />
<link rel="stylesheet" href="/css/style.css" />
