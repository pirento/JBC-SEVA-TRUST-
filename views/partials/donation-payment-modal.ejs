<div id="donationPaymentModal" class="modal-backdrop" hidden>

  <div
    class="donation-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="donationTitle"
  >

    <div class="modal-header">

      <h2 id="donationTitle">
        Make a Donation
      </h2>

      <button
        type="button"
        id="closeDonationPaymentModal"
        class="close-btn"
      >
        &times;
      </button>

    </div>


    <form
      action="/donate"
      method="POST"
      class="form-body"
    >

      <!-- DONOR NAME -->

      <div class="field">

        <label for="donationDonorName">
          Donor Name *
        </label>

        <input
          id="donationDonorName"
          name="donorName"
          type="text"
          placeholder="Enter donor name"
          maxlength="100"
          required
        />

      </div>


      <hr />


      <!-- PHONE + EMAIL -->

      <div class="form-grid">

        <div class="field">

          <label for="donationPhoneNumber">
            Phone Number *
          </label>

          <input
            id="donationPhoneNumber"
            name="phoneNumber"
            type="text"
            inputmode="numeric"
            maxlength="10"
            placeholder="Phone number"
            pattern="[0-9]{10}"
            required
          />

        </div>


        <div class="field">

          <label for="donationEmail">
            Email Id *
          </label>

          <input
            id="donationEmail"
            name="email"
            type="email"
            placeholder="Email"
            required
          />

        </div>

      </div>


      <hr />


      <!-- DONATION AMOUNT -->

      <div class="field">

        <label for="donationAmount">
          Donation Amount (₹) *
        </label>

        <input
          id="donationAmount"
          name="amount"
          type="number"
          min="100"
          step="1"
          placeholder="Enter donation amount"
          required
        />

        <small>
          Minimum donation amount: ₹100
        </small>

      </div>


      <hr />


      <!-- PAYMENT MODE -->

      <div class="field">

        <label>
          Payment Mode *
        </label>

        <div class="radio-row">

          <label>
            <input
              type="radio"
              name="paymentMode"
              value="UPI"
              required
            />
            UPI
          </label>

          <label>
            <input
              type="radio"
              name="paymentMode"
              value="Card"
            />
            Card
          </label>

          <label>
            <input
              type="radio"
              name="paymentMode"
              value="Net Banking"
            />
            Net Banking
          </label>

        </div>

      </div>


      <hr />


      <!-- MESSAGE -->

      <div class="field">

        <label for="donationMessage">
          Message
        </label>

        <textarea
          id="donationMessage"
          name="message"
          rows="3"
          placeholder="Any message for the trust (optional)"
        ></textarea>

      </div>


      <!-- ACTIONS -->

      <div class="actions">

        <button
          type="button"
          id="cancelDonationPayment"
          class="btn secondary"
        >
          Cancel
        </button>

        <button
          type="submit"
          class="btn primary"
        >
          Donate Now
        </button>

      </div>

    </form>

  </div>

</div>