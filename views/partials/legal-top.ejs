<!DOCTYPE html>
<html lang="<%= locals.lang || 'en' %>">
<head>
  <%- include('head') %>
</head>
<body class="page-bg">
  <%- include('header') %>

  <main id="main" class="legal-page">
    <nav class="legal-nav" aria-label="Legal pages">
      <a href="/terms" class="<%= currentPath === '/terms' ? 'active' : '' %>">Terms &amp; Conditions</a>
      <a href="/privacy-policy" class="<%= currentPath === '/privacy-policy' ? 'active' : '' %>">Privacy Policy</a>
      <a href="/refund-policy" class="<%= currentPath === '/refund-policy' ? 'active' : '' %>">Refund Policy</a>
      <a href="/disclaimer" class="<%= currentPath === '/disclaimer' ? 'active' : '' %>">Disclaimer</a>
    </nav>

    <article class="legal-content">
      <% if (locals.lang === 'hi') { %>
        <p class="alert" lang="hi" style="background:var(--cream);">यह कानूनी पाठ अंग्रेज़ी में है। किसी भी मतभेद की स्थिति में अंग्रेज़ी संस्करण ही मान्य होगा।</p>
      <% } %>
      <h1><%= title %></h1>
      <p class="muted">Last updated: <%= updated %></p>
