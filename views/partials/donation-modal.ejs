<div id="donationModal" class="modal-backdrop" hidden>
  <div class="donation-modal" role="dialog" aria-modal="true" aria-labelledby="membershipTitle">
    <div class="modal-header">
      <h2 id="membershipTitle">Become a Member</h2>
      <button type="button" class="close-btn" data-close-modal aria-label="Close">&times;</button>
    </div>
    <%- include('membership-form', { inModal: true, idPrefix: 'membershipModal' }) %>
  </div>
</div>
