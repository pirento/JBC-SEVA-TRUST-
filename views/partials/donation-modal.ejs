<div id="donationModal" class="modal-backdrop" hidden>
  <div
    class="donation-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="membershipTitle"
  >
    <div class="modal-header">
      <h2 id="membershipTitle">Become a Member</h2>

      <button type="button" id="closeDonationModal" class="close-btn">
        &times;
      </button>
    </div>

    <form action="/donation" method="POST" class="form-body">

      <!-- =====================================================
           MEMBER DETAILS
      ====================================================== -->
      <div class="field">
        <label for="memberName">Member Name *</label>

        <input
          id="memberName"
          name="memberName"
          type="text"
          placeholder="Enter member name"
          maxlength="100"
          required
        />
      </div>

      <hr />

      <!-- =====================================================
           CONTACT DETAILS
      ====================================================== -->
      <div class="form-grid">
        <div class="field">
          <label for="phoneNumber">Phone Number *</label>

          <input
            id="phoneNumber"
            name="phoneNumber"
            type="text"
            inputmode="numeric"
            maxlength="10"
            placeholder="Phone number"
            pattern="[0-9]{10}"
            required
          />
        </div>

        <div class="field">
          <label for="email">Email Id *</label>

          <input
            id="email"
            name="email"
            type="email"
            placeholder="Email"
            required
          />
        </div>
      </div>

      <hr />

      <!-- =====================================================
           MEMBERSHIP AMOUNT
      ====================================================== -->
      <div class="field">
        <label for="amount">Membership Amount (₹) *</label>

        <input
          id="amount"
          name="amount"
          type="number"
          min="100"
          step="1"
          placeholder="Enter amount"
          required
        />

        <small id="minimumAmountText">
          Minimum membership amount: ₹100
        </small>

        <small>
          ₹100 – ₹10,999: 1 Year Membership |
          ₹11,000 or more: Lifetime Membership
        </small>
      </div>

      <hr />

      <!-- =====================================================
           PAYMENT MODE
      ====================================================== -->
      <div class="field">
        <label>Payment Mode *</label>

        <div class="radio-row">
          <label>
            <input
              type="radio"
              name="paymentMode"
              value="UPI"
              required
            />
            UPI
          </label>

          <label>
            <input
              type="radio"
              name="paymentMode"
              value="Card"
            />
            Card
          </label>

          <label>
            <input
              type="radio"
              name="paymentMode"
              value="Net Banking"
            />
            Net Banking
          </label>
        </div>
      </div>

      <hr />

      <!-- =====================================================
           MESSAGE
      ====================================================== -->
      <div class="field">
        <label for="message">Message</label>

        <textarea
          id="message"
          name="message"
          rows="3"
          placeholder="Any message for the trust (optional)"
        ></textarea>
      </div>

      <!-- =====================================================
           ACTIONS
      ====================================================== -->
      <div class="actions">
        <button
          type="button"
          id="cancelDonation"
          class="btn secondary"
        >
          Cancel
        </button>

        <button type="submit" class="btn primary">
          Become a Member
        </button>
      </div>
    </form>
  </div>
</div>