<footer class="site-footer">
  <div class="footer-grid">

    <div class="footer-about">
      <a href="/" class="footer-brand">
        <img src="/images/logo-mark.png" alt="" width="48" height="48">
        <span><strong>JBC</strong> <em>SEVA TRUST</em></span>
      </a>
      <p class="footer-hindi" lang="hi"><%= trust.taglineHindi %></p>
      <p class="muted">
        A <%= trust.legalForm.toLowerCase() %> in <%= trust.location %>, working for
        elders, poor families, children and the environment.
      </p>
    </div>

    <div>
      <h3>Our Work</h3>
      <ul class="footer-list">
        <li><a href="/#about">About the Trust</a></li>
        <li><a href="/updates">Updates from the Field</a></li>
        <% trust.programmes.forEach((p) => { %>
          <li><a href="/work/<%= p.slug %>"><%= p.title %></a></li>
        <% }) %>
      </ul>
    </div>

    <div>
      <h3>Get Involved</h3>
      <ul class="footer-list">
        <li><a href="/donate">Donate</a></li>
        <li><a href="/donation">Become a Member</a></li>
        <li><a href="/volunteer">Volunteer</a></li>
        <li><a href="/events">Events</a></li>
        <li><a href="/contact?type=csr">CSR Partnership</a></li>
        <li><a href="/medical">Medical Help Request</a></li>
      </ul>
    </div>

    <div>
      <h3>Contact</h3>
      <ul class="footer-list contact-list">
        <li><%- include('icon', { name: 'pin', size: 18 }) %> <%= trust.location %></li>
        <% if (trustEmail) { %>
          <li><%- include('icon', { name: 'mail', size: 18 }) %> <a href="mailto:<%= trustEmail %>"><%= trustEmail %></a></li>
        <% } %>
        <li><%- include('icon', { name: 'arrow', size: 18 }) %> <a href="/contact">Send us a message</a></li>
      </ul>
    </div>

  </div>

  <div class="footer-bottom">
    <p>© <%= year %> <%= trust.name %>. All rights reserved.</p>
    <nav aria-label="Legal" class="footer-legal">
      <a href="/terms">Terms</a>
      <a href="/privacy-policy">Privacy</a>
      <a href="/refund-policy">Refunds</a>
      <a href="/disclaimer">Disclaimer</a>
    </nav>
  </div>
</footer>

<script src="/js/main.js" defer></script>
