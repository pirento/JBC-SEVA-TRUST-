<footer class="site-footer">
  <div class="footer-grid">

    <div class="footer-about">
      <a href="/" class="footer-brand">
        <img src="/images/logo-mark.png" alt="" width="48" height="48">
        <span><strong>JBC</strong> <em>SEVA TRUST</em></span>
      </a>
      <% if (lang !== 'hi') { %><p class="footer-hindi" lang="hi"><%= trust.taglineHindi %></p><% } %>
      <p class="muted">
        A <%= trust.legalForm.toLowerCase() %> in <%= trust.location %>, working for
        elders, poor families, children and the environment.
      </p>
    </div>

    <div>
      <h3>Our Work</h3>
      <ul class="footer-list">
        <li><a href="/#about">About the Trust</a></li>
        <li><a href="/updates">Updates from the Field</a></li>
        <% trust.programmes.forEach((p) => { %>
          <li><a href="/work/<%= p.slug %>"><%= p.title %></a></li>
        <% }) %>
      </ul>
    </div>

    <div>
      <h3>Get Involved</h3>
      <ul class="footer-list">
        <li><a href="/donate">Donate</a></li>
        <li><a href="/donation">Become a Member</a></li>
        <li><a href="/volunteer">Volunteer</a></li>
        <li><a href="/events">Events</a></li>
        <li><a href="/contact?type=csr">CSR Partnership</a></li>
        <li><a href="/medical">Medical Help Request</a></li>
      </ul>
    </div>

    <div>
      <h3>Contact</h3>
      <ul class="footer-list contact-list">
        <li><%- include('icon', { name: 'pin', size: 18 }) %> <%= trust.location %></li>
        <% if (trustEmail) { %>
          <li><%- include('icon', { name: 'mail', size: 18 }) %> <a href="mailto:<%= trustEmail %>"><%= trustEmail %></a></li>
        <% } %>
        <% if (trustWhatsapp) { %>
          <li><%- include('icon', { name: 'arrow', size: 18 }) %> <a href="https://wa.me/91<%= trustWhatsapp %>" target="_blank" rel="noopener">WhatsApp: +91 <%= trustWhatsapp %></a></li>
        <% } %>
        <li><%- include('icon', { name: 'arrow', size: 18 }) %> <a href="/contact">Send us a message</a></li>
      </ul>
    </div>

  </div>

  <div class="footer-bottom">
    <p>© <%= year %> <%= trust.name %>. All rights reserved.</p>
    <nav aria-label="Legal" class="footer-legal">
      <a href="/terms">Terms</a>
      <a href="/privacy-policy">Privacy</a>
      <a href="/refund-policy">Refunds</a>
      <a href="/disclaimer">Disclaimer</a>
    </nav>
  </div>
</footer>

<% if (trustWhatsapp) { %>
  <a class="whatsapp-float" href="https://wa.me/91<%= trustWhatsapp %>" target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2.1 1-2.4c.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .6l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.4 1.8 2.2 1.2 1.1 2.2 1.4 2.5 1.6.3.1.5.1.7-.1l.9-1.1c.2-.3.4-.2.7-.1l2 .9c.3.1.5.2.5.3.1.2.1.7-.1 1.3Z"/></svg>
  </a>
<% } %>

<script src="/js/main.js" defer></script>
