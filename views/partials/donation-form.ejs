<% const p = locals.idPrefix || 'donation'; const user = locals.currentUser || {}; %>
<form action="/donate" method="POST" class="form-body js-once">

  <div class="field">
    <label for="<%= p %>Cause">Donate For *</label>
    <select id="<%= p %>Cause" name="cause" required>
      <% trust.donationCauses.forEach((cause) => { %>
        <option value="<%= cause %>" <%= cause === locals.selectedCause ? 'selected' : '' %>><%= cause %></option>
      <% }) %>
    </select>
    <small>Money given for a cause is used only for that cause.</small>
  </div>

  <div class="field">
    <label for="<%= p %>Name">Donor Name *</label>
    <input id="<%= p %>Name" name="donorName" type="text" autocomplete="name"
      placeholder="Full name" maxlength="100" value="<%= user.name || '' %>" required />
  </div>

  <div class="form-grid">
    <div class="field">
      <label for="<%= p %>Phone">Mobile Number *</label>
      <input id="<%= p %>Phone" name="phoneNumber" type="tel" inputmode="numeric" autocomplete="tel-national"
        maxlength="10" pattern="[6-9][0-9]{9}" title="10 digit mobile number"
        placeholder="10 digit mobile number" value="<%= user.phone || '' %>" required />
    </div>

    <div class="field">
      <label for="<%= p %>Email">Email *</label>
      <input id="<%= p %>Email" name="email" type="email" autocomplete="email"
        placeholder="you@example.com" value="<%= user.email || '' %>" required />
    </div>
  </div>

  <div class="field">
    <label for="<%= p %>Amount">Donation Amount (₹) *</label>
    <input id="<%= p %>Amount" name="amount" type="number" min="100" step="1" inputmode="numeric"
      placeholder="Minimum ₹100" value="<%= locals.selectedAmount || '' %>" required />
    <div class="amount-chips" data-target="<%= p %>Amount">
      <% [501, 1100, 2100, 5100].forEach((value) => { %>
        <button type="button" class="chip" data-amount="<%= value %>">₹<%= value.toLocaleString('en-IN') %></button>
      <% }) %>
    </div>
  </div>

  <%- include('payment-mode') %>

  <div class="field">
    <label for="<%= p %>Message">Message <span class="muted">(optional)</span></label>
    <textarea id="<%= p %>Message" name="message" rows="3" maxlength="500"
      placeholder="Any message for the trust"></textarea>
  </div>

  <%- include('consent', { withRefund: true }) %>

  <div class="actions">
    <% if (locals.inModal) { %>
      <button type="button" class="btn secondary" data-close-modal>Cancel</button>
    <% } %>
    <button type="submit" class="btn primary">Donate Securely</button>
  </div>
</form>
