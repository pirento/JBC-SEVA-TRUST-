<!DOCTYPE html>
<html lang="<%= locals.lang || 'en' %>">
<head>
  <%- include('../partials/head', { title: 'Request Submitted' }) %>
  <meta name="robots" content="noindex" />
</head>
<body class="page-bg">
  <%- include('../partials/header') %>

  <main id="main" class="result-page">
    <div class="result-card thank-you">
      <div class="success-mark" aria-hidden="true"><%- include('../partials/icon', { name: 'check', size: 34 }) %></div>
      <h1>Medical help request submitted</h1>
      <p class="lead">Our team will review the request and contact you.</p>

      <% if (reference) { %>
        <table class="receipt-table">
          <tbody>
            <tr><th scope="row">Reference number</th><td class="mono"><%= reference %></td></tr>
          </tbody>
        </table>
      <% } %>

      <div class="button-row center">
        <% if (file) { %>
          <a href="/medical/receipt/<%= encodeURIComponent(file) %>" class="btn orange">Download Receipt</a>
        <% } %>
        <a href="/" class="btn secondary">Back to Home</a>
      </div>

      <p class="muted small">A copy of the receipt is sent to the email you gave. Keep the reference number for any follow-up.</p>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
