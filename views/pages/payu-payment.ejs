<!DOCTYPE html>
<html lang="<%= locals.lang || 'en' %>">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Secure Membership Payment - JBC Seva Trust
    </title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            font-family: Arial, sans-serif;

            background:
                linear-gradient(
                    135deg,
                    #f5f7fa,
                    #e8eef5
                );
        }

        .payment-card {
            width: 90%;
            max-width: 500px;

            background: white;

            padding: 35px;

            border-radius: 14px;

            box-shadow:
                0 10px 35px
                rgba(0, 0, 0, 0.12);

            text-align: center;
        }

        .payment-card h1 {
            margin-bottom: 10px;
        }

        .payment-card p {
            color: #555;
            line-height: 1.6;
        }

        .amount {
            font-size: 28px;
            font-weight: bold;

            margin: 20px 0;
        }

        .loader {
            width: 45px;
            height: 45px;

            margin: 25px auto;

            border: 4px solid #ddd;

            border-top-color: #333;

            border-radius: 50%;

            animation:
                spin 1s linear infinite;
        }

        @keyframes spin {

            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }

        }

        .secure {
            font-size: 13px;
            color: #777;
        }

        .pay-button {
            margin-top: 20px;

            padding: 12px 25px;

            border: none;

            border-radius: 7px;

            cursor: pointer;

            font-size: 15px;
        }

    </style>

</head>


<body>


    <div class="payment-card">

        <h1>
            Secure Membership Payment
        </h1>


        <p>
            You are being redirected to
            PayU's secure payment gateway
            to complete your membership payment.
        </p>


        <div class="amount">

            ₹ <%= paymentData.amount %>

        </div>


        <div class="loader"></div>


        <p>
            Please wait...
        </p>


        <p class="secure">

            🔒 Your payment information is
            securely processed by PayU.

        </p>


        <!-- ================================= -->
        <!-- PAYU FORM -->
        <!-- ================================= -->

        <form
            id="payuForm"
            action="<%= paymentUrl %>"
            method="POST"
        >

            <% Object.entries(paymentData).forEach(([key, value]) => { %>

                <input
                    type="hidden"
                    name="<%= key %>"
                    value="<%= value %>"
                >

            <% }) %>


            <!-- Fallback button -->

            <button
                type="submit"
                class="pay-button"
            >
                Continue to Payment
            </button>

        </form>

    </div>


    <!-- ================================= -->
    <!-- AUTO SUBMIT -->
    <!-- ================================= -->

    <script>

        window.addEventListener(
            "load",
            function () {

                // PayU rejects a reused txnid, so never re-post this form
                // when the user comes back (Back button / UPI app return).
                var key = "payu_submitted_" + <%- JSON.stringify(String(paymentData.txnid)) %>;
                var form = document.getElementById("payuForm");

                try {
                    if (sessionStorage.getItem(key)) {
                        form.style.display = "none";
                        document.querySelector(".loader").style.display = "none";
                        document.querySelector(".amount").insertAdjacentHTML(
                            "afterend",
                            "<p>This payment was already started. If money was debited, please do not pay again - contact the Trust with transaction ID: <b>" +
                            <%- JSON.stringify(String(paymentData.txnid)) %> +
                            "</b>. Otherwise, <a href='/'>start a new payment</a>.</p>"
                        );
                        return;
                    }
                } catch (e) {}

                form.addEventListener("submit", function () {
                    try { sessionStorage.setItem(key, "1"); } catch (e) {}
                });

                setTimeout(
                    function () {

                        try { sessionStorage.setItem(key, "1"); } catch (e) {}
                        form.submit();

                    },
                    1000
                );

            }
        );

    </script>


</body>

</html>