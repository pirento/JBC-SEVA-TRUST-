<!DOCTYPE html>
<html lang="<%= locals.lang || 'en' %>">
<head>
  <%- include('../partials/head', { title: 'Membership' }) %>
</head>
<body class="page-bg">
  <%- include('../partials/header') %>

  <main id="main" class="form-page">
    <section class="form-card narrow">
      <h1 class="form-title">Become a Member</h1>
      <p class="form-intro">Join <%= trust.name %> and receive a membership certificate by email.</p>
      <% if (!currentUser) { %>
        <p class="form-intro">No login needed. After payment, login details for your account are emailed to you.</p>
      <% } %>
      <% if (locals.error) { %>
        <div class="alert error" role="alert"><%= error %></div>
      <% } %>
      <%- include('../partials/membership-form', { idPrefix: 'membershipPage', values: locals.values || {} }) %>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
