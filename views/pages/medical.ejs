<!DOCTYPE html>
<html lang="<%= locals.lang || 'en' %>">
<head>
  <%- include('../partials/head', { title: 'Medical Help' }) %>
</head>

<body class="page-bg">

  <%- include('../partials/header') %>

  <% const user = currentUser || {}; const v = locals.values || {}; const today = new Date().toLocaleDateString('en-CA'); %>

  <main id="main" class="form-page">

    <section class="form-card">

      <h1 class="form-title">Medical Help Request</h1>
      <p class="form-intro">
        Fill in the patient's details. You will get a reference number and a
        PDF receipt by email, and our team will contact you.
      </p>

      <% if (locals.error) { %>
        <div class="alert error" role="alert"><%= error %></div>
      <% } %>

      <form action="/medical" method="POST" class="form-body js-once">

        <h2 class="form-section">Patient Details</h2>

        <div class="form-grid">
          <div class="field">
            <label for="patientName">Patient's Name *</label>
            <input id="patientName" type="text" name="patientName" maxlength="150"
              autocomplete="off" required placeholder="Full name" value="<%= v.patientName || '' %>" />
          </div>

          <div class="field">
            <label for="aadharNumber">Aadhaar Number *</label>
            <input id="aadharNumber" type="text" name="aadharNumber" maxlength="12"
              pattern="[0-9]{12}" title="12 digit Aadhaar number" inputmode="numeric"
              autocomplete="off" required placeholder="12 digit Aadhaar number"
              aria-describedby="aadharHelp" value="<%= v.aadharNumber || '' %>" />
            <small id="aadharHelp">Stored encrypted. Only the last 4 digits appear on the receipt.</small>
          </div>

          <div class="field">
            <label for="dateBirth">Date of Birth *</label>
            <input id="dateBirth" type="date" name="dateBirth" min="1900-01-01" max="<%= today %>" required value="<%= v.dateBirth || '' %>" />
          </div>

          <div class="field">
            <label for="patientReferenceName">Referred By <span class="muted">(optional)</span></label>
            <input id="patientReferenceName" type="text" name="patientReferenceName" maxlength="150"
              placeholder="Name of person who referred" value="<%= v.patientReferenceName || '' %>" />
          </div>
        </div>

        <h2 class="form-section">Contact Details</h2>

        <div class="form-grid">
          <div class="field">
            <label for="patientPhoneNumber">Mobile Number *</label>
            <input id="patientPhoneNumber" type="tel" name="patientPhoneNumber" maxlength="15"
              pattern="[6-9][0-9]{9}" title="10 digit mobile number" inputmode="numeric"
              autocomplete="tel-national" required placeholder="10 digit mobile number"
              value="<%= v.patientPhoneNumber || user.phone || '' %>" />
          </div>

          <div class="field">
            <label for="patientEmail">Email *</label>
            <input id="patientEmail" type="email" name="patientEmail" autocomplete="email"
              required placeholder="you@example.com" value="<%= v.patientEmail || user.email || '' %>" />
          </div>
        </div>

        <h2 class="form-section">Medical Details</h2>

        <div class="form-grid">
          <div class="field">
            <label for="nameDiseases">Illness / Disease *</label>
            <input id="nameDiseases" type="text" name="nameDiseases" maxlength="150"
              required placeholder="e.g. Cataract, Kidney stone" value="<%= v.nameDiseases || '' %>" />
          </div>

          <div class="field">
            <label for="hospitalName">Hospital Name *</label>
            <input id="hospitalName" type="text" name="hospitalName" maxlength="150"
              required placeholder="Hospital where treatment is planned" value="<%= v.hospitalName || '' %>" />
          </div>
        </div>

        <%- include('../partials/honeypot', { hpId: 'medical' }) %>
        <%- include('../partials/consent') %>

        <div class="actions center">
          <button class="btn primary" type="submit">Submit Request</button>
        </div>

      </form>

    </section>

  </main>

  <%- include('../partials/footer') %>

</body>
</html>
