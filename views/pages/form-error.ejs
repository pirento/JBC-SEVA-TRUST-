<!DOCTYPE html>
<html lang="<%= locals.lang || 'en' %>">
  <head>
    <%- include('../partials/head', { title: locals.title || 'Something went wrong' }) %>
  </head>
  <body class="page-bg">
    <%- include('../partials/header') %>
    <main id="main" class="result-page">
      <div class="result-card" role="alert">
        <img src="/images/logo-mark.png" alt="" width="64" height="64" class="result-logo">
        <h1><%= locals.title || 'Submission Failed' %></h1>
        <p class="error-text"><%= message %></p>
        <a class="btn red" href="<%= backUrl %>">Go Back</a>
      </div>
    </main>
    <%- include('../partials/footer') %>
  </body>
</html>
