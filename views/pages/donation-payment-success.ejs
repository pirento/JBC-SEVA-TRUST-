<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    Donation Successful - JBC Seva Trust
  </title>

  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;

      display: flex;
      align-items: center;
      justify-content: center;

      font-family: Arial, sans-serif;

      background:
        linear-gradient(
          135deg,
          #f5f7fa,
          #e8eef5
        );
    }

    .success-card {
      width: 90%;
      max-width: 650px;

      background: white;

      padding: 40px;

      border-radius: 14px;

      box-shadow:
        0 10px 35px
        rgba(0, 0, 0, 0.12);

      text-align: center;
    }

    .success-icon {
      width: 70px;
      height: 70px;

      margin: 0 auto 20px;

      display: flex;
      align-items: center;
      justify-content: center;

      border-radius: 50%;

      background: #e8f7ee;

      font-size: 38px;
    }

    h1 {
      margin: 0 0 10px;

      color: #222;
    }

    .message {
      color: #555;

      line-height: 1.6;

      margin-bottom: 25px;
    }

    .details {
      width: 100%;

      border-collapse: collapse;

      margin: 20px 0 30px;

      text-align: left;
    }

    .details td {
      padding: 12px;

      border-bottom: 1px solid #eeeeee;
    }

    .details td:first-child {
      font-weight: bold;
    }

    .details td:last-child {
      text-align: right;

      word-break: break-word;
    }

    .buttons {
      display: flex;

      gap: 12px;

      justify-content: center;

      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;

      padding: 12px 22px;

      border-radius: 7px;

      text-decoration: none;

      font-size: 14px;

      cursor: pointer;

      border: none;
    }

    .primary {
      background: #222;

      color: white;
    }

    .secondary {
      background: #eeeeee;

      color: #222;
    }

    .email-note {
      margin-top: 20px;

      padding: 14px;

      background: #f5f8fb;

      border-radius: 7px;

      font-size: 14px;

      color: #555;

      line-height: 1.6;
    }

  </style>

</head>


<body>

  <div class="success-card">

    <div class="success-icon">
      ✓
    </div>


    <h1>
      Donation Successful
    </h1>


    <p class="message">

      Thank you for your generous donation to
      <strong>JBC Seva Trust</strong>.

      Your donation has been successfully received.

    </p>


    <table class="details">

      <tr>

        <td>
          Donor Name
        </td>

        <td>
          <%= donation?.donorName || "N/A" %>
        </td>

      </tr>


      <tr>

        <td>
          Donation Amount
        </td>

        <td>
          ₹<%= Number(donation?.amount || 0).toFixed(2) %>
        </td>

      </tr>


      <tr>

        <td>
          Payment Mode
        </td>

        <td>
          <%= donation?.paymentMode || "N/A" %>
        </td>

      </tr>


      <tr>

        <td>
          Transaction ID
        </td>

        <td>
          <%= transactionId || "N/A" %>
        </td>

      </tr>


      <tr>

        <td>
          Payment ID
        </td>

        <td>
          <%= paymentId || "N/A" %>
        </td>

      </tr>

    </table>


    <div class="email-note">

      Your donation has been successfully recorded.

      <br>

      <strong>
        Your Donation Certificate has been generated successfully.
      </strong>

      <br>

      A copy of the certificate has also been sent
      to your registered email address.

    </div>


    <div class="buttons">

      <% if (certificatePath || certificateNumber) { %>

        <a
          href="/donate/certificate/<%= transactionId %>"
          class="btn primary"
        >
          Download Donation Certificate
        </a>

      <% } %>


      <a
        href="/"
        class="btn secondary"
      >
        Back to Home
      </a>

    </div>

  </div>

</body>

</html>