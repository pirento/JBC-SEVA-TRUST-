<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head') %>
  </head>

  <body class="page-bg">

    <%- include('../partials/header') %>

    <main id="main">

      <!-- HERO -->
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="hero-hindi" lang="hi"><%= trust.taglineHindi %></p>
            <h1><%= trust.tagline %></h1>
            <p class="lead"><%= trust.mission %></p>

            <div class="button-row">
              <a href="/donate" class="btn orange">Donate</a>
              <a href="/volunteer" class="btn navy-outline">Volunteer with us</a>
            </div>

            <p class="hero-note">
              <%- include('../partials/icon', { name: 'receipt', size: 18 }) %>
              Receipt by email for every donation · Payments through PayU
            </p>
          </div>

          <aside class="hero-panel" aria-labelledby="panelTitle">
            <h2 id="panelTitle">Our five programmes</h2>
            <ul>
              <% trust.programmes.forEach((p) => { %>
                <li>
                  <a href="/work/<%= p.slug %>">
                    <span class="panel-icon"><%- include('../partials/icon', { name: p.icon }) %></span>
                    <span>
                      <strong><%= p.title %></strong>
                      <small><%= p.area %></small>
                    </span>
                  </a>
                </li>
              <% }) %>
            </ul>
          </aside>
        </div>
      </section>

      <!-- PROGRAMMES -->
      <section id="work" class="section">
        <div class="container">
          <header class="section-head">
            <h2>What we do</h2>
            <p>
              Every programme is run by our trustees and volunteers on the ground
              in Basti. Money given for a programme is used only for that programme.
            </p>
          </header>

          <div class="programme-grid">
            <% trust.programmes.forEach((p) => { %>
              <article class="programme" id="<%= p.slug %>">
                <div class="programme-top">
                  <span class="programme-icon"><%- include('../partials/icon', { name: p.icon, size: 28 }) %></span>
                  <span class="programme-hindi" lang="hi"><%= p.hindi %></span>
                </div>
                <h3><a href="/work/<%= p.slug %>"><%= p.title %></a></h3>
                <p class="programme-area"><%= p.area %></p>
                <p><%= p.summary %></p>
                <div class="programme-links">
                  <a href="/work/<%= p.slug %>">Read more</a>
                  <a href="/donate/<%= p.slug %>" class="donate-link">Donate to <%= p.title %></a>
                </div>
              </article>
            <% }) %>

            <article class="programme programme-general">
              <h3>Where most needed</h3>
              <p>
                Not sure which programme to choose? The trustees will use your
                gift where the need is most urgent, and tell you how it was spent.
              </p>
              <a href="/donate/general" class="btn orange">Donate</a>
            </article>
          </div>
        </div>
      </section>

      <!-- TRANSPARENCY -->
      <section class="section navy">
        <div class="container">
          <header class="section-head">
            <h2>How we handle every rupee</h2>
            <p>Trust is earned with records, not words. This is how we keep ours.</p>
          </header>

          <div class="promise-grid">
            <div class="promise">
              <%- include('../partials/icon', { name: 'ledger', size: 30 }) %>
              <h3>A separate fund for each cause</h3>
              <p>Each programme has its own ledger, and the temple fund is kept apart from the charitable work.</p>
            </div>
            <div class="promise">
              <%- include('../partials/icon', { name: 'receipt', size: 30 }) %>
              <h3>A receipt for every donation</h3>
              <p>You get a receipt or certificate by email as soon as your payment is confirmed.</p>
            </div>
            <div class="promise">
              <%- include('../partials/icon', { name: 'camera', size: 30 }) %>
              <h3>Proof of the work</h3>
              <p>Geotagged photos of trees we plant and delivery proof of kits we give.</p>
            </div>
            <div class="promise">
              <%- include('../partials/icon', { name: 'sign', size: 30 }) %>
              <h3>Both trustees sign</h3>
              <p>Every decision is signed by both trustees, and the bank account is run jointly.</p>
            </div>
            <div class="promise">
              <%- include('../partials/icon', { name: 'audit', size: 30 }) %>
              <h3>Audited every year</h3>
              <p>Accounts run April to March and are audited every year.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- PLAN -->
      <section class="section">
        <div class="container">
          <header class="section-head">
            <h2>Our plan</h2>
            <p>
              We are starting with small, well-documented projects so that every
              later step rests on real numbers. These are plans, not results yet.
            </p>
          </header>

          <div class="table-wrap plan-table">
            <table>
              <thead>
                <tr>
                  <th scope="col">Programme</th>
                  <th scope="col">First year</th>
                  <th scope="col">Years 2–3</th>
                  <th scope="col">How we will measure it</th>
                </tr>
              </thead>
              <tbody>
                <% trust.programmes.forEach((p) => { %>
                  <tr>
                    <th scope="row"><a href="/work/<%= p.slug %>"><%= p.title %></a></th>
                    <td><%= p.year1 %></td>
                    <td><%= p.later %></td>
                    <td><%= p.measure %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <% if (latestUpdates.length || upcomingEvents.length) { %>
      <!-- FROM THE FIELD -->
      <section class="section">
        <div class="container field-grid<%= latestUpdates.length && upcomingEvents.length ? '' : ' single' %>">
          <% if (latestUpdates.length) { %>
            <div>
              <header class="section-head">
                <h2>From the field</h2>
                <p>Recent photos and news. <a href="/updates">See all updates</a></p>
              </header>
              <div class="update-grid compact">
                <% latestUpdates.forEach((update) => { %><%- include('../partials/update-card', { update }) %><% }) %>
              </div>
            </div>
          <% } %>
          <% if (upcomingEvents.length) { %>
            <div>
              <header class="section-head">
                <h2>Upcoming events</h2>
                <p><a href="/events">All events</a></p>
              </header>
              <div class="event-list">
                <% upcomingEvents.forEach((event) => { %><%- include('../partials/event-row', { event }) %><% }) %>
              </div>
            </div>
          <% } %>
        </div>
      </section>
      <% } %>

      <!-- GET INVOLVED -->
      <section class="section cream">
        <div class="container">
          <header class="section-head">
            <h2>How you can help</h2>
          </header>

          <div class="involve-grid">
            <div class="involve">
              <%- include('../partials/icon', { name: 'heart', size: 30 }) %>
              <h3>Donate</h3>
              <p>Give online by UPI, card or net banking and choose the cause your money goes to.</p>
              <div class="button-row">
                <a href="/donate" class="btn orange">Donate</a>
                <a href="/donation" class="text-link">Become a member</a>
              </div>
            </div>
            <div class="involve">
              <%- include('../partials/icon', { name: 'hands', size: 30 }) %>
              <h3>Volunteer</h3>
              <p>Plant trees, spend time with elders, help at weddings or teach children. Volunteers get a certificate.</p>
              <div class="button-row">
                <a href="/volunteer" class="btn navy">Register as volunteer</a>
              </div>
            </div>
            <div class="involve">
              <%- include('../partials/icon', { name: 'building', size: 30 }) %>
              <h3>Partner with us</h3>
              <p>Companies, doctors, schools, panchayats and youth groups can work with us on any programme.</p>
              <div class="button-row">
                <a href="/contact?type=csr" class="btn navy-outline">Talk to us</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ABOUT -->
      <section id="about" class="section">
        <div class="container about-grid">
          <div>
            <h2>About the trust</h2>
            <p>
              <%= trust.name %> is a <%= trust.legalForm.toLowerCase() %> based in
              <%= trust.location %>. "JBC" stands for Jang Bahadur Chaudhary, who
              started the trust together with Ravikant Soni.
            </p>
            <p>
              The trust is an independent body with its own bank account, books and
              donors, and is not linked to any company.
            </p>
            <blockquote class="vision">
              <p>“<%= trust.vision %>”</p>
              <cite>Our vision</cite>
            </blockquote>
          </div>

          <div class="trustee-list">
            <h3>Trustees</h3>
            <% trust.trustees.forEach((t) => { %>
              <div class="trustee">
                <div class="avatar" aria-hidden="true"><%= t.name.split(' ').map((w) => w[0]).join('').slice(0, 2) %></div>
                <div>
                  <strong><%= t.name %></strong>
                  <span class="trustee-role"><%= t.role %></span>
                  <p><%= t.work %></p>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
      </section>

    </main>

    <%- include('../partials/footer') %>

  </body>
</html>
