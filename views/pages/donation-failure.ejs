<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width,initial-scale=1"
  />

  <title>
    Membership Payment Failed - JBC Seva Trust
  </title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  />
</head>

<body class="page-bg">

  <main class="result-page">

    <div
      class="result-card"
      style="text-align:center;"
    >

      <div
        style="
          font-size:56px;
          margin-bottom:15px;
        "
      >
        ❌
      </div>

      <h2>
        Membership Payment Failed
      </h2>

      <p>
        Your membership payment could not be completed.
      </p>

      <% if (transactionId) { %>

        <p>
          <strong>
            Transaction ID:
          </strong>

          <%= transactionId %>
        </p>

      <% } %>

      <p class="error-text">
        <%= errorMessage %>
      </p>

      <a
        class="btn red"
        href="/"
      >
        Try Again
      </a>

    </div>

  </main>

</body>

</html>