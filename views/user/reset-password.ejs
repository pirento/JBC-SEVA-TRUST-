<!DOCTYPE html>
<html lang="<%= locals.lang || 'en' %>">
<head>
  <%- include('../partials/head', { title: 'Set New Password' }) %>
</head>
<body class="page-bg">
  <%- include('../partials/header') %>

  <main id="main" class="form-page">
    <section class="form-card auth-card">
      <h1 class="form-title">Set a new password</h1>

      <% if (error) { %>
        <div class="alert error" role="alert"><%= error %></div>
      <% } %>

      <% if (!valid) { %>
        <% if (!error) { %>
          <div class="alert error" role="alert">This reset link is invalid or has expired. Please ask for a new one.</div>
        <% } %>
        <p class="auth-switch"><a href="/forgot-password" class="btn orange">Get a new link</a></p>
      <% } else { %>
        <form action="/reset-password/<%= token %>" method="POST" class="form-body js-once">
          <div class="field">
            <label for="password">New Password</label>
            <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="72" required aria-describedby="pwHelp" />
            <small id="pwHelp">At least 8 characters, with a letter and a number.</small>
          </div>
          <div class="field">
            <label for="confirmPassword">Confirm New Password</label>
            <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="72" required />
          </div>
          <div class="actions">
            <button type="submit" class="btn orange full">Save new password</button>
          </div>
        </form>
      <% } %>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
