<!DOCTYPE html>
<html lang="<%= locals.lang || 'en' %>">
<head>
  <%- include('../partials/head', { title: 'Choose Your Password' }) %>
  <meta name="robots" content="noindex" />
</head>
<body class="page-bg">
  <%- include('../partials/header') %>

  <main id="main" class="form-page">
    <section class="form-card auth-card">
      <h1 class="form-title">Choose your password</h1>
      <p class="muted">You logged in with the temporary password from your email. Please choose your own password to continue.</p>

      <% if (error) { %>
        <div class="alert error" role="alert"><%= error %></div>
      <% } %>

      <form action="/account/set-password" method="POST" class="form-body js-once">
        <div class="field">
          <label for="password">New Password</label>
          <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" maxlength="72" required aria-describedby="pwHelp" />
          <small id="pwHelp">At least 8 characters, with a letter and a number.</small>
        </div>
        <div class="field">
          <label for="confirmPassword">Confirm New Password</label>
          <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="72" required />
        </div>
        <div class="actions">
          <button type="submit" class="btn orange full">Save password</button>
        </div>
      </form>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
