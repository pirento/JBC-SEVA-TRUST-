<!DOCTYPE html>
<html lang="<%= locals.lang || 'en' %>">
<head>
  <%- include('../partials/head', { title: 'Forgot Password' }) %>
</head>
<body class="page-bg">
  <%- include('../partials/header') %>

  <main id="main" class="form-page">
    <section class="form-card auth-card">
      <h1 class="form-title">Forgot password</h1>
      <p class="form-intro">Enter the email you registered with. We will send you a link to set a new password.</p>

      <% if (sent) { %>
        <div class="alert success" role="status">
          If an account exists for that email, a reset link has been sent. It works for one hour.
        </div>
      <% } %>
      <% if (error) { %>
        <div class="alert error" role="alert"><%= error %></div>
      <% } %>

      <form action="/forgot-password" method="POST" class="form-body js-once">
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required autofocus />
        </div>
        <div class="actions">
          <button type="submit" class="btn orange full">Send reset link</button>
        </div>
      </form>

      <p class="auth-switch"><a href="/login">Back to login</a></p>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
