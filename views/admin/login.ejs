<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Admin Login' }) %>
  <meta name="robots" content="noindex" />
</head>
<body class="page-bg">
  <%- include('../partials/header') %>

  <main id="main" class="form-page">
    <section class="form-card auth-card">
      <img src="/images/logo-mark.png" alt="" width="64" height="64" class="result-logo">
      <h1 class="form-title">Admin Login</h1>
      <p class="form-intro">For authorised trustees only.</p>

      <% if (error) { %>
        <div class="alert error" role="alert"><%= error %></div>
      <% } %>

      <form action="/admin/login" method="POST" class="form-body js-once">
        <div class="field">
          <label for="password">Admin Password</label>
          <div class="password-wrap">
            <input type="password" id="password" name="password" required autocomplete="current-password" autofocus />
            <button type="button" class="toggle-password" aria-label="Show password" data-toggle-password="password">Show</button>
          </div>
        </div>

        <div class="actions">
          <button type="submit" class="btn primary full">Login</button>
        </div>
      </form>

      <p class="auth-switch"><a href="/">← Back to Home</a></p>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
