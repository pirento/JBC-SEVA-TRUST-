<!-- =====================================================
     JAVASCRIPT
===================================================== -->

<script>

(() => {


  /* =====================================================
     MEMBERSHIP FILTER
  ===================================================== */

  const membershipSearch =
    document.getElementById(
      "membershipSearch"
    );

  const membershipPaymentModeFilter =
    document.getElementById(
      "membershipPaymentModeFilter"
    );

  const membershipTypeFilter =
    document.getElementById(
      "membershipTypeFilter"
    );

  const membershipRows =
    Array.from(
      document.querySelectorAll(
        ".membership-row"
      )
    );

  const noMembershipResults =
    document.getElementById(
      "noMembershipResults"
    );


  function filterMemberships() {

    const search =
      String(
        membershipSearch?.value || ""
      )
      .trim()
      .toLowerCase();


    const paymentMode =
      String(
        membershipPaymentModeFilter?.value ||
        ""
      )
      .trim()
      .toLowerCase();


    const membershipType =
      String(
        membershipTypeFilter?.value ||
        ""
      )
      .trim()
      .toLowerCase();


    let visibleCount = 0;


    membershipRows.forEach(
      (row) => {

        const rowSearch =
          String(
            row.dataset.search || ""
          )
          .toLowerCase();


        const rowPaymentMode =
          String(
            row.dataset.paymentMode || ""
          )
          .toLowerCase();


        const rowMembershipType =
          String(
            row.dataset.membershipType || ""
          )
          .toLowerCase();


        const matchesSearch =
          !search ||
          rowSearch.includes(
            search
          );


        const matchesPaymentMode =
          !paymentMode ||
          rowPaymentMode ===
            paymentMode;


        const matchesMembershipType =
          !membershipType ||
          rowMembershipType ===
            membershipType;


        const visible =
          matchesSearch &&
          matchesPaymentMode &&
          matchesMembershipType;


        row.style.display =
          visible
            ? ""
            : "none";


        if (visible) {
          visibleCount++;
        }

      }
    );


    if (noMembershipResults) {

      noMembershipResults.style.display =
        membershipRows.length > 0 &&
        visibleCount === 0
          ? "block"
          : "none";

    }

  }


  membershipSearch?.addEventListener(
    "input",
    filterMemberships
  );


  membershipPaymentModeFilter
    ?.addEventListener(
      "change",
      filterMemberships
    );


  membershipTypeFilter
    ?.addEventListener(
      "change",
      filterMemberships
    );


  /* =====================================================
     DONATION FILTER
  ===================================================== */

  const donationSearch =
    document.getElementById(
      "donationSearch"
    );

  const donationPaymentModeFilter =
    document.getElementById(
      "donationPaymentModeFilter"
    );

  const donationAmountFilter =
    document.getElementById(
      "donationAmountFilter"
    );

  const donationRows =
    Array.from(
      document.querySelectorAll(
        ".donation-row"
      )
    );

  const noDonationResults =
    document.getElementById(
      "noDonationResults"
    );


  function filterDonations() {

    const search =
      String(
        donationSearch?.value || ""
      )
      .trim()
      .toLowerCase();


    const paymentMode =
      String(
        donationPaymentModeFilter?.value ||
        ""
      )
      .trim()
      .toLowerCase();


    const minimumAmount =
      Number(
        donationAmountFilter?.value || 0
      );


    let visibleCount = 0;


    donationRows.forEach(
      (row) => {

        const rowSearch =
          String(
            row.dataset.search || ""
          )
          .toLowerCase();


        const rowPaymentMode =
          String(
            row.dataset.paymentMode || ""
          )
          .toLowerCase();


        const rowAmount =
          Number(
            row.dataset.amount || 0
          );


        const matchesSearch =
          !search ||
          rowSearch.includes(
            search
          );


        const matchesPaymentMode =
          !paymentMode ||
          rowPaymentMode ===
            paymentMode;


        const matchesAmount =
          !minimumAmount ||
          rowAmount >=
            minimumAmount;


        const visible =
          matchesSearch &&
          matchesPaymentMode &&
          matchesAmount;


        row.style.display =
          visible
            ? ""
            : "none";


        if (visible) {
          visibleCount++;
        }

      }
    );


    if (noDonationResults) {

      noDonationResults.style.display =
        donationRows.length > 0 &&
        visibleCount === 0
          ? "block"
          : "none";

    }

  }


  donationSearch?.addEventListener(
    "input",
    filterDonations
  );


  donationPaymentModeFilter
    ?.addEventListener(
      "change",
      filterDonations
    );


  donationAmountFilter
    ?.addEventListener(
      "change",
      filterDonations
    );


  /* =====================================================
     DATE-WISE REPORT
  ===================================================== */

  const reportDate =
    document.getElementById(
      "reportDate"
    );

  const clearReportDate =
    document.getElementById(
      "clearReportDate"
    );

  const downloadDailyReport =
    document.getElementById(
      "downloadDailyReport"
    );


  const selectedMembershipCount =
    document.getElementById(
      "selectedMembershipCount"
    );

  const selectedDonationCount =
    document.getElementById(
      "selectedDonationCount"
    );

  const selectedMedicalCount =
    document.getElementById(
      "selectedMedicalCount"
    );


  const selectedMembershipCollection =
    document.getElementById(
      "selectedMembershipCollection"
    );

  const selectedDonationCollection =
    document.getElementById(
      "selectedDonationCollection"
    );

  const selectedTotalCollection =
    document.getElementById(
      "selectedTotalCollection"
    );


  const selectedDateText =
    document.getElementById(
      "selectedDateText"
    );


  const reportMembershipRows =
    Array.from(
      document.querySelectorAll(
        ".membership-row"
      )
    );


  const reportDonationRows =
    Array.from(
      document.querySelectorAll(
        ".donation-row"
      )
    );


  const reportMedicalRows =
    Array.from(
      document.querySelectorAll(
        ".medical-row"
      )
    );


  function formatReportDate(
    value
  ) {

    if (!value) {
      return "";
    }


    const parts =
      value.split("-");


    if (
      parts.length !== 3
    ) {
      return value;
    }


    return (
      parts[2] +
      "-" +
      parts[1] +
      "-" +
      parts[0]
    );

  }


  function updateDateWiseReport() {

    const selectedDate =
      String(
        reportDate?.value || ""
      )
      .trim();


    /* -----------------------------------------
       RESET
    ----------------------------------------- */

    if (!selectedDate) {

      selectedMembershipCount.textContent =
        "0";

      selectedDonationCount.textContent =
        "0";

      selectedMedicalCount.textContent =
        "0";


      selectedMembershipCollection.textContent =
        "₹0";

      selectedDonationCollection.textContent =
        "₹0";

      selectedTotalCollection.textContent =
        "₹0";


      selectedDateText.style.display =
        "none";

      return;

    }


    /* -----------------------------------------
       MEMBERSHIPS
    ----------------------------------------- */

    const selectedMemberships =
      reportMembershipRows.filter(
        (row) =>
          row.dataset.reportDate ===
          selectedDate
      );


    /* -----------------------------------------
       DONATIONS
    ----------------------------------------- */

    const selectedDonations =
      reportDonationRows.filter(
        (row) =>
          row.dataset.reportDate ===
          selectedDate
      );


    /* -----------------------------------------
       MEDICAL
    ----------------------------------------- */

    const selectedMedical =
      reportMedicalRows.filter(
        (row) =>
          row.dataset.reportDate ===
          selectedDate
      );


    /* -----------------------------------------
       MEMBERSHIP COLLECTION
    ----------------------------------------- */

    const membershipCollection =
      selectedMemberships.reduce(
        (
          total,
          row
        ) => {

          return (
            total +
            Number(
              row.dataset.reportAmount ||
              0
            )
          );

        },
        0
      );


    /* -----------------------------------------
       DONATION COLLECTION
    ----------------------------------------- */

    const donationCollection =
      selectedDonations.reduce(
        (
          total,
          row
        ) => {

          return (
            total +
            Number(
              row.dataset.reportAmount ||
              0
            )
          );

        },
        0
      );


    /* -----------------------------------------
       TOTAL
    ----------------------------------------- */

    const totalCollection =
      membershipCollection +
      donationCollection;


    /* -----------------------------------------
       COUNTS
    ----------------------------------------- */

    selectedMembershipCount.textContent =
      selectedMemberships.length;


    selectedDonationCount.textContent =
      selectedDonations.length;


    selectedMedicalCount.textContent =
      selectedMedical.length;


    /* -----------------------------------------
       AMOUNTS
    ----------------------------------------- */

    selectedMembershipCollection.textContent =
      "₹" +
      membershipCollection.toLocaleString(
        "en-IN"
      );


    selectedDonationCollection.textContent =
      "₹" +
      donationCollection.toLocaleString(
        "en-IN"
      );


    selectedTotalCollection.textContent =
      "₹" +
      totalCollection.toLocaleString(
        "en-IN"
      );


    /* -----------------------------------------
       MESSAGE
    ----------------------------------------- */

    selectedDateText.style.display =
      "block";


    selectedDateText.innerHTML =
      `
        Showing records for
        <strong>
          ${formatReportDate(
            selectedDate
          )}
        </strong>
      `;

  }


  reportDate?.addEventListener(
    "change",
    updateDateWiseReport
  );


  clearReportDate?.addEventListener(
    "click",
    () => {

      if (reportDate) {
        reportDate.value = "";
      }

      updateDateWiseReport();

    }
  );


  downloadDailyReport?.addEventListener(
    "click",
    () => {

      const selectedDate =
        String(
          reportDate?.value || ""
        ).trim();

      if (!selectedDate) {
        alert(
          "Please select a date first."
        );
        return;
      }

      window.location.href =
        `/admin/report/download?date=${encodeURIComponent(
          selectedDate
        )}`;

    }
  );


})();

</script>


</body>

</html>