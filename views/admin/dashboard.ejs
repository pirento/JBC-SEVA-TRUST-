<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Admin Dashboard' }) %>
  <meta name="robots" content="noindex" />
</head>
<body class="page-bg admin-page">
  <%- include('../partials/admin-header') %>

  <%
    const rupees = (n) => '₹' + Number(n || 0).toLocaleString('en-IN');
    const link = (changes) => {
      const params = new URLSearchParams({ date, view, q, page: 1, ...changes });
      for (const [k, v] of [...params]) if (!v || (k === 'page' && v === '1')) params.delete(k);
      const text = params.toString();
      return '/admin/dashboard' + (text ? '?' + text : '');
    };
    const tabLabels = { donations: 'Donations', memberships: 'Memberships', medical: 'Medical', volunteers: 'Volunteers', messages: 'Messages' };
    const prog = (slug) => (trust.programmes.find((p) => p.slug === slug) || {}).title;
  %>

  <main id="main" class="account-page">

    <div class="account-head">
      <div>
        <h1>Dashboard</h1>
        <p class="muted"><%= date ? `Showing ${new Date(date + 'T00:00:00').toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}` : 'Showing all time' %></p>
      </div>

      <form method="GET" action="/admin/dashboard" class="date-form">
        <input type="hidden" name="view" value="<%= view %>" />
        <label for="date" class="sr-only">Date</label>
        <input id="date" type="date" name="date" value="<%= date %>" max="<%= new Date().toISOString().slice(0, 10) %>" />
        <button type="submit" class="btn navy small-btn">Show day</button>
        <% if (date) { %>
          <a href="<%= link({ date: '' }) %>" class="btn secondary small-btn">All time</a>
          <a href="/admin/report/download?date=<%= date %>" class="btn orange small-btn">Daily report (PDF)</a>
        <% } %>
      </form>
    </div>

    <section class="stats admin-stats" aria-label="Totals">
      <div class="stat"><span>Total collection</span><strong><%= rupees(stats.totalCollection) %></strong></div>
      <div class="stat"><span>Donations</span><strong><%= stats.donationCount %></strong><small><%= rupees(stats.donationAmount) %></small></div>
      <div class="stat"><span>Memberships</span><strong><%= stats.membershipCount %></strong><small><%= rupees(stats.membershipAmount) %></small></div>
      <div class="stat"><span>Medical requests</span><strong><%= stats.medicalCount %></strong></div>
      <div class="stat"><span>Volunteers</span><strong><%= stats.volunteerCount %></strong></div>
      <div class="stat"><span>Messages</span><strong><%= stats.messageCount %></strong></div>
      <div class="stat"><span>Registered users</span><strong><%= stats.userCount %></strong></div>
      <div class="stat"><span>Active monthly donors</span><strong><%= stats.activePledges %></strong></div>
    </section>

    <div class="admin-two">
      <section class="panel">
        <h2>Fund-wise collection</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Fund</th><th>Donations</th><th>Amount</th></tr></thead>
            <tbody>
              <% funds.forEach((fund) => { %>
                <tr>
                  <td><strong><%= fund.cause %></strong></td>
                  <td><%= fund.count %></td>
                  <td><%= rupees(fund.amount) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="panel">
        <h2>Download Excel (CSV)</h2>
        <p class="muted small">Full records for accounts and audit.<% if (!trust.eightyG.approved) { %> Form 10BD appears here once 80G approval is entered in the settings.<% } %></p>
        <div class="filter-row">
          <% exportTypes.forEach((type) => { %>
            <a href="/admin/export/<%= type %>" class="csv-link"><%= type.replace(/-/g, ' ') %></a>
          <% }) %>
        </div>
      </section>
    </div>

    <section class="panel">
      <nav class="tabs" aria-label="Records">
        <% views.forEach((name) => { %>
          <a href="<%= link({ view: name, q: '' }) %>" class="<%= name === view ? 'active' : '' %>" <% if (name === view) { %>aria-current="page"<% } %>><%= tabLabels[name] %></a>
        <% }) %>
      </nav>

      <form method="GET" action="/admin/dashboard" class="search-form">
        <input type="hidden" name="view" value="<%= view %>" />
        <% if (date) { %><input type="hidden" name="date" value="<%= date %>" /><% } %>
        <label for="q" class="sr-only">Search</label>
        <input id="q" name="q" type="search" value="<%= q %>" placeholder="Search name, phone, email, transaction..." />
        <button type="submit" class="btn navy small-btn">Search</button>
        <% if (q) { %><a href="<%= link({ q: '' }) %>" class="btn secondary small-btn">Clear</a><% } %>
      </form>

      <p class="muted small"><%= list.total %> record(s)<%= q ? ` matching "${q}"` : '' %><%= list.pages > 1 ? ` · page ${list.page} of ${list.pages}` : '' %></p>

      <% if (list.total === 0) { %>
        <p class="empty-note">No records here yet.</p>
      <% } else { %>
        <div class="table-wrap">
          <table class="admin-table">
            <% if (view === 'donations') { %>
              <thead><tr><th>Date</th><th>Donor</th><th>Fund / Purpose</th><th>Amount</th><th>Payment</th><th>Actions</th></tr></thead>
              <tbody>
                <% list.rows.forEach((d) => { %>
                  <tr>
                    <td><%= d.date %><br><small class="muted"><%= d.time %></small></td>
                    <td><strong><%= d.donorName %></strong><br><small><%= d.phoneNumber %> · <%= d.email %></small><% if (d.pan) { %><br><small>PAN: <%= d.pan %></small><% } %></td>
                    <td>
                      <strong><%= d.cause || 'Where Most Needed' %></strong>
                      <% if (d.purpose) { %><br><small><%= d.purpose %></small><% } %>
                      <% if (d.dedication) { %><br><small><%= d.dedication %></small><% } %>
                      <% if (d.sevaDate) { %><br><small>Seva date: <%= d.sevaDate %></small><% } %>
                      <% if (d.gotra) { %><br><small>Gotra: <%= d.gotra %></small><% } %>
                      <% if (d.message) { %><br><small class="muted">“<%= d.message %>”</small><% } %>
                    </td>
                    <td><strong><%= rupees(d.amount) %></strong></td>
                    <td><%= d.paymentMode %><br><small class="mono"><%= d.transactionId %></small></td>
                    <td><a href="/donate/certificate/<%= encodeURIComponent(d.transactionId) %>">PDF</a> · <a href="/admin/records/donation/<%= encodeURIComponent(d.transactionId) %>/edit">Edit</a></td>
                  </tr>
                <% }) %>
              </tbody>
            <% } else if (view === 'memberships') { %>
              <thead><tr><th>Date</th><th>Member</th><th>Type</th><th>Amount</th><th>Payment</th><th>Actions</th></tr></thead>
              <tbody>
                <% list.rows.forEach((m) => { %>
                  <tr>
                    <td><%= m.date %><br><small class="muted"><%= m.time %></small></td>
                    <td><strong><%= m.memberName %></strong><br><small><%= m.phoneNumber %> · <%= m.email %></small></td>
                    <td><%= m.membershipType %></td>
                    <td><strong><%= rupees(m.amount) %></strong></td>
                    <td><%= m.paymentMode %><br><small class="mono"><%= m.transactionId %></small></td>
                    <td><a href="/donation/receipt/<%= encodeURIComponent(m.transactionId) %>">PDF</a> · <a href="/admin/records/membership/<%= encodeURIComponent(m.transactionId) %>/edit">Edit</a></td>
                  </tr>
                <% }) %>
              </tbody>
            <% } else if (view === 'medical') { %>
              <thead><tr><th>Date</th><th>Patient</th><th>Contact</th><th>Illness / Hospital</th><th>Reference</th><th>Actions</th></tr></thead>
              <tbody>
                <% list.rows.forEach((r) => { %>
                  <tr>
                    <td><%= r.date %><br><small class="muted"><%= r.time %></small></td>
                    <td><strong><%= r.patientName %></strong><br><small>DOB <%= r.dateBirth %> · Aadhaar XXXX-<%= String(r.aadharNumber).slice(-4) %></small><% if (r.patientReferenceName) { %><br><small>Referred by <%= r.patientReferenceName %></small><% } %></td>
                    <td><%= r.patientPhoneNumber %><br><small><%= r.patientEmail %></small></td>
                    <td><%= r.nameDiseases %><br><small><%= r.hospitalName %></small></td>
                    <td class="mono"><%= r.referenceRegistrationNumber %></td>
                    <td><a href="/medical/receipt/<%= encodeURIComponent(r.receiptFile || `Medical-Help-Receipt-${r.referenceRegistrationNumber}.pdf`) %>">PDF</a> · <a href="/admin/records/medical/<%= encodeURIComponent(r.referenceRegistrationNumber) %>/edit">Edit</a></td>
                  </tr>
                <% }) %>
              </tbody>
            <% } else if (view === 'volunteers') { %>
              <thead><tr><th>Date</th><th>Name</th><th>Contact</th><th>Village / City</th><th>Areas</th><th>Availability</th><th>Message</th></tr></thead>
              <tbody>
                <% list.rows.forEach((v) => { %>
                  <tr>
                    <td><%= new Date(v.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'Asia/Kolkata' }) %></td>
                    <td><strong><%= v.name %></strong></td>
                    <td><%= v.phone %><br><small><%= v.email %></small></td>
                    <td><%= v.city %></td>
                    <td><%= [].concat(v.areas || []).join(', ') %></td>
                    <td><%= v.availability %></td>
                    <td class="wrap"><%= v.message || '-' %></td>
                  </tr>
                <% }) %>
              </tbody>
            <% } else { %>
              <thead><tr><th>Date</th><th>Type</th><th>From</th><th>Contact</th><th>Message</th></tr></thead>
              <tbody>
                <% list.rows.forEach((m) => { %>
                  <tr>
                    <td><%= new Date(m.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'Asia/Kolkata' }) %></td>
                    <td><strong><%= m.enquiryType %></strong></td>
                    <td><%= m.name %><% if (m.organisation) { %><br><small><%= m.organisation %></small><% } %></td>
                    <td><%= m.phone %><br><small><%= m.email %></small></td>
                    <td class="wrap"><%= m.message %></td>
                  </tr>
                <% }) %>
              </tbody>
            <% } %>
          </table>
        </div>

        <% if (list.pages > 1) { %>
          <nav class="pagination" aria-label="Pages">
            <% if (list.page > 1) { %><a href="<%= link({ page: list.page - 1 }) %>">← Newer</a><% } %>
            <span>Page <%= list.page %> of <%= list.pages %></span>
            <% if (list.page < list.pages) { %><a href="<%= link({ page: list.page + 1 }) %>">Older →</a><% } %>
          </nav>
        <% } %>
      <% } %>
    </section>

  </main>
</body>
</html>
