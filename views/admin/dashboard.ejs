<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    Admin Dashboard - JBC Seva Trust
  </title>

  <link
    rel="stylesheet"
    href="/css/style.css"
  >

  <style>

    /* =====================================================
       BASE
    ===================================================== */

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: #f5f6f8;
      color: #1f2937;
      font-family: Arial, Helvetica, sans-serif;
    }

    button,
    input,
    select {
      font: inherit;
    }


    /* =====================================================
       MAIN CONTAINER
    ===================================================== */

    .dashboard-shell {
      width: min(96%, 1550px);
      margin: 24px auto 50px;
    }


    /* =====================================================
       HEADER
    ===================================================== */

    .dashboard-header {
      background: #fff;
      border: 1px solid #e8e8e8;
      border-radius: 18px;

      padding: 18px 22px;

      display: flex;
      align-items: center;
      justify-content: space-between;

      gap: 20px;

      box-shadow:
        0 8px 30px rgba(0, 0, 0, 0.05);

      margin-bottom: 22px;
    }

    .dashboard-brand {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .dashboard-logo {
      width: 56px;
      height: 56px;

      border-radius: 13px;

      object-fit: cover;

      border: 1px solid #eee;
    }

    .dashboard-brand h1 {
      margin: 0;

      font-size: 24px;

      font-weight: 700;

      color: #971b1b;
    }

    .dashboard-brand p {
      margin: 5px 0 0;

      font-size: 13px;

      color: #737b87;
    }

    .dashboard-actions {
      display: flex;
      align-items: center;
      gap: 9px;
    }

    .home-btn,
    .logout-btn {
      border: none;

      text-decoration: none;

      cursor: pointer;

      border-radius: 9px;

      padding: 10px 16px;

      font-size: 13px;

      font-weight: 600;
    }

    .home-btn {
      background: #f3f4f6;
      color: #333;
    }

    .logout-btn {
      background: #971b1b;
      color: #fff;
    }

    .home-btn:hover,
    .logout-btn:hover {
      opacity: .88;
    }


    /* =====================================================
       PAGE TITLE
    ===================================================== */

    .welcome-section {
      margin: 8px 3px 20px;
    }

    .welcome-section h2 {
      margin: 0;

      font-size: 27px;

      color: #222;

      letter-spacing: -.4px;
    }

    .welcome-section p {
      margin: 6px 0 0;

      color: #737b87;

      font-size: 14px;
    }


    /* =====================================================
       TOP STAT CARDS
    ===================================================== */

    .stats-grid {
      display: grid;

      grid-template-columns:
        repeat(5, minmax(0, 1fr));

      gap: 14px;

      margin-bottom: 20px;
    }

    .stat-card {
      position: relative;

      overflow: hidden;

      background: #fff;

      border: 1px solid #e8e8e8;

      border-radius: 16px;

      padding: 18px;

      min-height: 138px;

      box-shadow:
        0 5px 20px rgba(0, 0, 0, .045);
    }

    .stat-card::after {
      content: "";

      position: absolute;

      width: 85px;
      height: 85px;

      right: -28px;
      bottom: -28px;

      border-radius: 50%;

      background: rgba(151, 27, 27, .055);
    }

    .stat-icon {
      position: absolute;

      right: 15px;
      top: 15px;

      width: 37px;
      height: 37px;

      border-radius: 10px;

      background: #fff4e8;

      display: flex;

      align-items: center;
      justify-content: center;

      font-size: 17px;
    }

    .stat-label {
      color: #667085;

      font-size: 12px;

      font-weight: 600;

      margin-bottom: 10px;
    }

    .stat-value {
      color: #202124;

      font-size: 27px;

      font-weight: 750;

      line-height: 1.15;
    }

    .stat-subtitle {
      margin-top: 8px;

      color: #8a8f98;

      font-size: 11px;
    }


    /* =====================================================
       CARD
    ===================================================== */

    .dashboard-card {
      background: #fff;

      border: 1px solid #e8e8e8;

      border-radius: 17px;

      overflow: hidden;

      margin-bottom: 20px;

      box-shadow:
        0 6px 24px rgba(0, 0, 0, .04);
    }

    .card-header {
      padding: 19px 22px;

      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;

      border-bottom: 1px solid #ededed;
    }

    .card-title h2 {
      margin: 0;

      font-size: 19px;

      color: #222;
    }

    .card-title p {
      margin: 5px 0 0;

      color: #7a808a;

      font-size: 12px;
    }


    /* =====================================================
       TOP SUMMARY ROW
    ===================================================== */

    .summary-top-grid {
      display: grid;

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 18px;

      margin-bottom: 20px;
    }

    .summary-panel {
      background: #fff;

      border: 1px solid #e8e8e8;

      border-radius: 17px;

      overflow: hidden;

      box-shadow:
        0 6px 24px rgba(0, 0, 0, .04);
    }

    .summary-panel-header {
      padding: 18px 20px;

      border-bottom: 1px solid #eee;
    }

    .summary-panel-header h3 {
      margin: 0;

      font-size: 17px;

      color: #222;
    }

    .summary-panel-header p {
      margin: 4px 0 0;

      font-size: 12px;

      color: #7a808a;
    }

    .summary-panel-body {
      display: grid;

      grid-template-columns:
        repeat(2, minmax(0, 1fr));

      gap: 12px;

      padding: 17px;
    }

    .summary-box {
      background: #fafafa;

      border: 1px solid #ececec;

      border-radius: 11px;

      padding: 14px;
    }

    .summary-box-label {
      font-size: 11px;

      color: #777;

      margin-bottom: 7px;
    }

    .summary-box-value {
      font-size: 21px;

      font-weight: 750;

      color: #222;
    }


    /* =====================================================
       FILTERS
    ===================================================== */

    .filters {
      padding: 14px 20px;

      display: grid;

      grid-template-columns:
        minmax(260px, 1fr)
        180px
        180px;

      gap: 10px;

      background: #fafafa;

      border-bottom: 1px solid #eee;
    }

    .filter-input,
    .filter-select {
      width: 100%;

      min-height: 39px;

      border: 1px solid #dfe1e5;

      background: #fff;

      border-radius: 8px;

      padding: 9px 11px;

      outline: none;

      color: #333;

      font-size: 12px;
    }

    .filter-input:focus,
    .filter-select:focus {
      border-color: #971b1b;

      box-shadow:
        0 0 0 3px rgba(151, 27, 27, .08);
    }


    /* =====================================================
       TABLE
    ===================================================== */

    .table-scroll {
      width: 100%;

      overflow-x: auto;
    }

    .data-table {
      width: 100%;

      min-width: 1200px;

      border-collapse: collapse;
    }

    .medical-table {
      min-width: 1050px;
    }

    .data-table th {
      padding: 13px 15px;

      background: #fafafa;

      border-bottom: 1px solid #e6e6e6;

      color: #555;

      font-size: 10px;

      font-weight: 700;

      text-transform: uppercase;

      letter-spacing: .35px;

      white-space: nowrap;

      text-align: left;
    }

    .data-table td {
      padding: 14px 15px;

      border-bottom: 1px solid #f0f0f0;

      vertical-align: top;

      font-size: 12px;

      color: #444;
    }

    .data-table tbody tr:hover {
      background: #fffaf6;
    }


    /* =====================================================
       TABLE CONTENT
    ===================================================== */

    .member-primary,
    .donor-primary {
      font-weight: 700;

      color: #222;

      margin-bottom: 5px;
    }

    .amount-cell {
      font-weight: 700;

      font-size: 13px !important;

      color: #222 !important;

      white-space: nowrap;
    }

    .transaction-id,
    .payu-id {
      max-width: 170px;

      word-break: break-all;

      font-family: monospace;

      font-size: 10px;

      color: #555;
    }

    .payu-id {
      margin-top: 5px;

      color: #888;
    }

    .date-main {
      font-weight: 600;

      color: #333;

      white-space: nowrap;
    }

    .date-time {
      margin-top: 4px;

      color: #888;

      font-size: 10px;

      white-space: nowrap;
    }


    /* =====================================================
       BADGES
    ===================================================== */

    .badge {
      display: inline-flex;

      align-items: center;

      gap: 4px;

      padding: 5px 8px;

      border-radius: 20px;

      font-size: 10px;

      font-weight: 700;

      white-space: nowrap;
    }

    .badge-success {
      background: #eaf8ef;

      color: #16803c;
    }

    .badge-lifetime {
      background: #fff3df;

      color: #a45b00;
    }

    .badge-year {
      background: #edf4ff;

      color: #2563a8;
    }

    .badge-donation {
      background: #fff0e6;

      color: #b45309;
    }


    /* =====================================================
       CERTIFICATE
    ===================================================== */

    .certificate-btn {
      display: inline-block;

      background: #971b1b;

      color: #fff;

      text-decoration: none;

      padding: 7px 10px;

      border-radius: 7px;

      font-size: 10px;

      font-weight: 700;

      white-space: nowrap;
    }

    .certificate-btn:hover {
      opacity: .88;
    }


    /* =====================================================
       DATE REPORT
    ===================================================== */

    .date-report-header {
      display: flex;

      align-items: center;

      justify-content: space-between;

      gap: 15px;

      flex-wrap: wrap;
    }

    .date-picker-area {
      display: flex;

      align-items: center;

      gap: 8px;

      flex-wrap: wrap;
    }

    .date-picker-area label {
      color: #555;

      font-size: 12px;

      font-weight: 700;
    }

    .date-picker-area input {
      height: 39px;

      border: 1px solid #ddd;

      border-radius: 8px;

      padding: 7px 10px;

      outline: none;

      color: #333;

      background: #fff;
    }

    .date-picker-area input:focus {
      border-color: #971b1b;
    }

    .clear-date-btn {
      height: 39px;

      border: 1px solid #ddd;

      background: #f6f6f6;

      color: #444;

      border-radius: 8px;

      padding: 0 13px;

      cursor: pointer;

      font-size: 12px;

      font-weight: 600;
    }

    .clear-date-btn:hover {
      background: #eee;
    }

    .download-report-btn {
      height: 39px;
      border: none;
      background: #971b1b;
      color: #fff;
      border-radius: 8px;
      padding: 0 15px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
      transition: .2s ease;
    }

    .download-report-btn:hover {
      opacity: .88;
    }

    .download-report-btn:disabled {
      opacity: .6;
      cursor: not-allowed;
    }

    .date-summary-grid {
      display: grid;

      grid-template-columns:
        repeat(6, minmax(0, 1fr));

      gap: 12px;

      padding: 18px 20px;

      background: #fafafa;
    }

    .date-summary-card {
      background: #fff;

      border: 1px solid #e9e9e9;

      border-radius: 11px;

      padding: 14px;
    }

    .date-summary-label {
      color: #777;

      font-size: 10px;

      margin-bottom: 7px;
    }

    .date-summary-value {
      color: #222;

      font-size: 19px;

      font-weight: 750;
    }

    .selected-date-message {
      display: none;

      margin: 0 20px 18px;

      padding: 11px 13px;

      border-radius: 8px;

      background: #f8f9fa;

      color: #555;

      font-size: 12px;
    }


    /* =====================================================
       TODAY COLLECTION
    ===================================================== */

    .today-grid {
      display: grid;

      grid-template-columns:
        repeat(3, minmax(0, 1fr));

      gap: 14px;

      padding: 18px 20px;
    }


    /* =====================================================
       EMPTY
    ===================================================== */

    .empty-state {
      padding: 45px 20px;

      text-align: center;

      color: #777;
    }

    .empty-icon {
      font-size: 32px;

      margin-bottom: 9px;
    }

    .empty-state h3 {
      margin: 0 0 5px;

      color: #333;

      font-size: 16px;
    }

    .empty-state p {
      margin: 0;

      font-size: 12px;
    }


    /* =====================================================
       FOOTER
    ===================================================== */

    .dashboard-footer {
      text-align: center;

      margin-top: 25px;

      color: #8a8f98;

      font-size: 11px;
    }


    /* =====================================================
       RESPONSIVE
    ===================================================== */

    @media (max-width: 1250px) {

      .stats-grid {
        grid-template-columns:
          repeat(3, minmax(0, 1fr));
      }

      .date-summary-grid {
        grid-template-columns:
          repeat(3, minmax(0, 1fr));
      }

    }


    @media (max-width: 900px) {

      .summary-top-grid {
        grid-template-columns: 1fr;
      }

      .filters {
        grid-template-columns: 1fr;
      }

      .date-summary-grid {
        grid-template-columns:
          repeat(2, minmax(0, 1fr));
      }

      .today-grid {
        grid-template-columns: 1fr;
      }

    }


    @media (max-width: 650px) {

      .dashboard-shell {
        width: 94%;

        margin-top: 12px;
      }

      .dashboard-header {
        align-items: flex-start;

        flex-direction: column;

        padding: 16px;
      }

      .dashboard-actions {
        width: 100%;
      }

      .home-btn,
      .logout-btn {
        flex: 1;

        text-align: center;
      }

      .stats-grid {
        grid-template-columns: 1fr;
      }

      .summary-panel-body {
        grid-template-columns: 1fr;
      }

      .date-summary-grid {
        grid-template-columns: 1fr;
      }

      .date-report-header {
        align-items: flex-start;

        flex-direction: column;
      }

    }

  </style>

</head>


<body>


<main class="dashboard-shell">


  <!-- ===================================================
       HEADER
  =================================================== -->

  <header class="dashboard-header">

    <div class="dashboard-brand">

      <img
        src="/images/logo.jpeg"
        alt="JBC Seva Trust"
        class="dashboard-logo"
      >

      <div>

        <h1>
          JBC Seva Trust
        </h1>

        <p>
          Administration & Membership Management
        </p>

      </div>

    </div>


    <div class="dashboard-actions">

      <a
        href="/"
        class="home-btn"
      >
        ← Home
      </a>

      <form
        action="/admin/logout"
        method="POST"
        style="margin:0;"
      >

        <button
          type="submit"
          class="logout-btn"
        >
          Logout
        </button>

      </form>

    </div>

  </header>


  <!-- ===================================================
       TITLE
  =================================================== -->

  <section class="welcome-section">

    <h2>
      Admin Dashboard
    </h2>

    <p>
      Monitor memberships, donations, payments and medical requests.
    </p>

  </section>


  <!-- ===================================================
       TOP STATISTICS
  =================================================== -->

  <section class="stats-grid">


    <div class="stat-card">

      <div class="stat-icon">
        👥
      </div>

      <div class="stat-label">
        Total Members
      </div>

      <div class="stat-value">
        <%= totalMembers %>
      </div>

      <div class="stat-subtitle">
        Successful membership transactions
      </div>

    </div>


    <div class="stat-card">

      <div class="stat-icon">
        ₹
      </div>

      <div class="stat-label">
        Membership Collection
      </div>

      <div class="stat-value">
        ₹<%= Number(
          membershipCollection || 0
        ).toLocaleString("en-IN") %>
      </div>

      <div class="stat-subtitle">
        From successful memberships
      </div>

    </div>


    <div class="stat-card">

      <div class="stat-icon">
        ❤️
      </div>

      <div class="stat-label">
        Total Donations
      </div>

      <div class="stat-value">
        <%= donationCount %>
      </div>

      <div class="stat-subtitle">
        Successful donation payments
      </div>

    </div>


    <div class="stat-card">

      <div class="stat-icon">
        💰
      </div>

      <div class="stat-label">
        Donation Collection
      </div>

      <div class="stat-value">
        ₹<%= Number(
          donationCollection || 0
        ).toLocaleString("en-IN") %>
      </div>

      <div class="stat-subtitle">
        From successful donations
      </div>

    </div>


    <div class="stat-card">

      <div class="stat-icon">
        📊
      </div>

      <div class="stat-label">
        Total Collection
      </div>

      <div class="stat-value">
        ₹<%= Number(
          totalCollection || 0
        ).toLocaleString("en-IN") %>
      </div>

      <div class="stat-subtitle">
        Membership + Donations
      </div>

    </div>

  </section>


  <!-- ===================================================
       DATE-WISE REPORT
  =================================================== -->

  <section class="dashboard-card">


    <div class="card-header date-report-header">

      <div class="card-title">

        <h2>
          Date-wise Report
        </h2>

        <p>
          View memberships, donations and medical help for a selected date
        </p>

      </div>


      <div class="date-picker-area">

        <label for="reportDate">
          Select Date
        </label>

        <input
          type="date"
          id="reportDate"
        >

        <button
          type="button"
          id="clearReportDate"
          class="clear-date-btn"
        >
          Clear
        </button>

        <button
          type="button"
          id="downloadDailyReport"
          class="download-report-btn"
        >
          📥 Download Daily Report
        </button>

      </div>

    </div>


    <div class="date-summary-grid">


      <div class="date-summary-card">

        <div class="date-summary-label">
          Memberships
        </div>

        <div
          class="date-summary-value"
          id="selectedMembershipCount"
        >
          0
        </div>

      </div>


      <div class="date-summary-card">

        <div class="date-summary-label">
          Donations
        </div>

        <div
          class="date-summary-value"
          id="selectedDonationCount"
        >
          0
        </div>

      </div>


      <div class="date-summary-card">

        <div class="date-summary-label">
          Medical Help
        </div>

        <div
          class="date-summary-value"
          id="selectedMedicalCount"
        >
          0
        </div>

      </div>


      <div class="date-summary-card">

        <div class="date-summary-label">
          Membership Collection
        </div>

        <div
          class="date-summary-value"
          id="selectedMembershipCollection"
        >
          ₹0
        </div>

      </div>


      <div class="date-summary-card">

        <div class="date-summary-label">
          Donation Collection
        </div>

        <div
          class="date-summary-value"
          id="selectedDonationCollection"
        >
          ₹0
        </div>

      </div>


      <div class="date-summary-card">

        <div class="date-summary-label">
          Total Collection
        </div>

        <div
          class="date-summary-value"
          id="selectedTotalCollection"
        >
          ₹0
        </div>

      </div>


    </div>


    <div
      id="selectedDateText"
      class="selected-date-message"
    ></div>


  </section>



  <!-- ===================================================
       TOP SUMMARY
       MEMBERSHIP + DONATION
  =================================================== -->

  <section class="summary-top-grid">


    <!-- MEMBERSHIP SUMMARY -->

    <div class="summary-panel">

      <div class="summary-panel-header">

        <h3>
          Membership Summary
        </h3>

        <p>
          Current successful membership breakdown
        </p>

      </div>


      <div class="summary-panel-body">


        <div class="summary-box">

          <div class="summary-box-label">
            Total Memberships
          </div>

          <div class="summary-box-value">
            <%= membershipCount %>
          </div>

        </div>


        <div class="summary-box">

          <div class="summary-box-label">
            Lifetime Memberships
          </div>

          <div class="summary-box-value">
            <%= lifetimeMemberships %>
          </div>

        </div>


        <div class="summary-box">

          <div class="summary-box-label">
            1 Year Memberships
          </div>

          <div class="summary-box-value">
            <%= oneYearMemberships %>
          </div>

        </div>


        <div class="summary-box">

          <div class="summary-box-label">
            Collection
          </div>

          <div class="summary-box-value">
            ₹<%= Number(
              membershipCollection || 0
            ).toLocaleString("en-IN") %>
          </div>

        </div>


      </div>

    </div>


    <!-- DONATION SUMMARY -->

    <div class="summary-panel">

      <div class="summary-panel-header">

        <h3>
          Donation Summary
        </h3>

        <p>
          Successful donations received by the Trust
        </p>

      </div>


      <div class="summary-panel-body">


        <div class="summary-box">

          <div class="summary-box-label">
            Total Donations
          </div>

          <div class="summary-box-value">
            <%= donationCount %>
          </div>

        </div>


        <div class="summary-box">

          <div class="summary-box-label">
            Donation Collection
          </div>

          <div class="summary-box-value">
            ₹<%= Number(
              donationCollection || 0
            ).toLocaleString("en-IN") %>
          </div>

        </div>


        <div class="summary-box">

          <div class="summary-box-label">
            Today's Donations
          </div>

          <div class="summary-box-value">
            <%= todayDonations %>
          </div>

        </div>


        <div class="summary-box">

          <div class="summary-box-label">
            Total Collection
          </div>

          <div class="summary-box-value">
            ₹<%= Number(
              totalCollection || 0
            ).toLocaleString("en-IN") %>
          </div>

        </div>


      </div>

    </div>

  </section>


  <!-- ===================================================
       MEMBERSHIP PAYMENTS
  =================================================== -->

  <section class="dashboard-card">


    <div class="card-header">

      <div class="card-title">

        <h2>
          Membership Payments
        </h2>

        <p>
          Verified membership transactions
        </p>

      </div>

